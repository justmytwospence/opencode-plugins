{
  "name": "opencode-cache-guard",
  "version": "0.1.0",
  "description": "Asks before a prompt that would re-cache a large Anthropic conversation, shows the prompt cache's time left beside the prompt, and with Jev keeps the context lean: trims large tool output and compacts a cold cache on a one-second summary.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt-cache",
    "anthropic",
    "jev",
    "typesafe",
    "context",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/opencode-plugins",
    "directory": "packages/opencode-cache-guard"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/node": "^22.20.4",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
