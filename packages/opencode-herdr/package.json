{
  "name": "opencode-herdr",
  "version": "0.1.0",
  "description": "OpenCode inside herdr: interactive OpenCode children in herdr tabs, splits or worktrees, pending children, the session's title and model in herdr's sidebar, PR status on spaces, and the herdr RPC other components report through. The port of pi-herdr.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./rpc": "./src/herdr-rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "herdr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/opencode-plugins",
    "directory": "packages/opencode-herdr"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/node": "^22.20.4",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
